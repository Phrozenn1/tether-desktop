<Page
    x:Class="Tether.WinUI.FeaturePreviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollMode="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <Grid MinHeight="440" Padding="32">
            <StackPanel MaxWidth="600"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="18">
                <Border HorizontalAlignment="Left"
                        Padding="12,6"
                        CornerRadius="999"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <TextBlock Text="COMING TO WINDOWS"
                               FontSize="11"
                               FontWeight="SemiBold"
                               CharacterSpacing="90" />
                </Border>
                <TextBlock x:Name="PageTitle"
                           Text="Feature"
                           FontSize="34"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="PageSubtitle"
                           Text="A calmer way to work."
                           FontSize="20"
                           Opacity="0.8"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="PageDescription"
                           Text="This feature is still being ported."
                           FontSize="15"
                           Opacity="0.65"
                           TextWrapping="Wrap"
                           MaxWidth="520" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
