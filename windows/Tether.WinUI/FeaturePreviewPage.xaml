<Page
    x:Class="Tether.WinUI.FeaturePreviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer HorizontalScrollMode="Disabled"
                  VerticalScrollBarVisibility="Auto">
        <Grid MinHeight="440" Padding="24">
            <StackPanel MaxWidth="680"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Top"
                        Spacing="16">
                <TextBlock x:Name="PageTitle"
                           Text="Feature"
                           FontSize="28"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="PageSubtitle"
                           Text="A calmer way to work."
                           FontSize="16"
                           Opacity="0.82"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="PageDescription"
                           Text=""
                           FontSize="13"
                           Opacity="0.65"
                           TextWrapping="Wrap" />
                <TextBlock x:Name="StatusBanner"
                           Visibility="Collapsed"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <StackPanel x:Name="InteractivePanel"
                            Spacing="12" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
