<Page
    x:Class="Tether.WinUI.FlowPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="PageRoot"
          MinWidth="320"
          Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="WideLayout">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="760" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="ContentCard.Padding" Value="36" />
                        <Setter Target="TimerText.FontSize" Value="72" />
                        <Setter Target="FlowProgress.Width" Value="340" />
                        <Setter Target="ActionButtons.Orientation" Value="Horizontal" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <ScrollViewer HorizontalScrollMode="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <Grid MinHeight="440" Padding="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="8,4,8,16">
                    <StackPanel>
                        <TextBlock Text="FOCUS"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   CharacterSpacing="160" />
                        <TextBlock Text="Work at your own pace."
                                   FontSize="14"
                                   Opacity="0.62"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                    <Border x:Name="StatusBadge"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Padding="12,6"
                            CornerRadius="999"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <TextBlock x:Name="StatusText"
                                   Text="READY"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                    </Border>
                </Grid>

                <Border x:Name="ContentCard"
                        Grid.Row="1"
                        Padding="22"
                        CornerRadius="18"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Spacing="22">
                        <TextBlock x:Name="ModeText"
                                   Text="Ready when you are"
                                   HorizontalAlignment="Center"
                                   FontSize="17"
                                   Opacity="0.72" />
                        <TextBlock x:Name="TimerText"
                                   Text="00:00"
                                   HorizontalAlignment="Center"
                                   FontFamily="Cascadia Mono"
                                   FontSize="54"
                                   FontWeight="SemiBold"
                                   CharacterSpacing="30" />
                        <ProgressBar x:Name="FlowProgress"
                                     Width="260"
                                     Height="4"
                                     Minimum="0"
                                     Maximum="1"
                                     Value="0"
                                     Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                        <TextBlock x:Name="HelperText"
                                   Text="Work at your own pace. Breaks are earned as you go."
                                   MaxWidth="340"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   FontSize="14"
                                   Opacity="0.65" />
                        <StackPanel x:Name="ActionButtons"
                                    Orientation="Vertical"
                                    HorizontalAlignment="Center"
                                    Spacing="10"
                                    Margin="0,8,0,0">
                            <Button x:Name="ToggleButton"
                                    Content="Start focus"
                                    Style="{StaticResource AccentButtonStyle}"
                                    MinWidth="132"
                                    Click="Toggle_Click" />
                            <Button Content="5-minute start"
                                    MinWidth="132"
                                    Click="MicroStart_Click" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    Spacing="10">
                            <Button x:Name="BreakButton"
                                    Content="Take a break"
                                    Click="Break_Click" />
                            <Button Content="Reset"
                                    Click="Reset_Click" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Grid.Row="2"
                           Margin="8,14,8,0"
                           Text="Your timer syncs with Tether companion extensions."
                           HorizontalAlignment="Center"
                           FontSize="12"
                           Opacity="0.5" />
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
